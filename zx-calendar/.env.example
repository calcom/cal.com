# ── Access ────────────────────────────────────────────────────────────────
# Admin password for the Executive view (only Z & XOE). Required in production:
# without it the Executive view stays locked. Never commit the real value.
EXECUTIVE_PASSCODE=
# Random string used to sign the session cookie (openssl rand -base64 32).
AUTH_SECRET=

# ── People invited to every booked call ───────────────────────────────────
# Defaults: xoe@zannyworld.org and zantavius@zannyworld.org. Override only if needed.
# XOE_EMAIL=
# Z_EMAIL=
# INVITE_EMAILS=extra@zannyworld.org,another@zannyworld.org

# ── Email invites without Google (optional, https://resend.com) ───────────
# Also covers the Google account owner, whom Google never emails.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
INVITE_FROM="Z × XOE Calendar <calendar@zannyworld.org>"
# Time zones listed in invite email text (comma-separated). The app itself always
# shows times in each viewer's own time zone. Default: Pacific (Z) + Philippines.
CALENDAR_TIMEZONE=America/Los_Angeles,Asia/Manila

# ── Storage (Vercel → Storage → Upstash for Redis sets these automatically) ─
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN

# ── Google Calendar (bookings land in this account's calendar) ───────────
# OAuth client (type "Web application"), redirect URI:
#   https://<your-domain>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: skip the in-app "Connect Google" flow by pasting a refresh token.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Brain dump AI parsing ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
