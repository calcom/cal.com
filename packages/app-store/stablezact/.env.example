# Stablezact Payment Integration
# Get your public key from https://merchant.stablezact.com/settings

# Note: Public key is entered during app installation in Cal.com UI, not here

# Optional: Custom Stablezact API URL (defaults to production https://hub.stablezact.com)
# For the staging environment, use: https://talented-mercy-production.up.railway.app
STABLEZACT_API_URL=https://hub.stablezact.com

# Optional: Public API URL for frontend (defaults to production https://hub.stablezact.com)
NEXT_PUBLIC_STABLEZACT_API_URL=https://hub.stablezact.com

# Required for webhook verification: the signing secret from your Stablezact dashboard.
# Incoming webhook signatures are checked against this value.
STABLEZACT_WEBHOOK_SECRET=
